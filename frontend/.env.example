# Anubadak Frontend Environment Configuration Example
# Copy this file to frontend/.env for local development:
#   cp frontend/.env.example frontend/.env
#
# IMPORTANT SECURITY RULE:
# Only store the public URL of the FastAPI backend here.
# NEVER store private API keys or credentials in VITE_* variables.
#
# Default for single-device development: http://localhost:8000
# For testing from phones/tablets over local Wi-Fi: http://<your-lan-ip>:8000

VITE_API_BASE_URL=http://localhost:8000
