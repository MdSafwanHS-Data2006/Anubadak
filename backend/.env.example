# Anubadak Backend Environment Configuration Example
# Copy this file to backend/.env for local customization:
#   cp backend/.env.example backend/.env

# MyMemory API endpoint (default official endpoint)
MYMEMORY_API_URL=https://api.mymemory.translated.net/get

# Optional contact email ('de' parameter) for MyMemory higher daily usage tier.
# Leave blank for anonymous free usage (~5,000 chars/day per MyMemory docs).
# Never expose this value to the frontend or commit a real email to Git.
MYMEMORY_EMAIL=

# Outbound HTTP timeout in seconds
REQUEST_TIMEOUT_SECONDS=10.0

# Comma-separated list of allowed frontend origins for CORS (never use * in production)
# To test from smartphones, tablets, or other computers on your local Wi-Fi network,
# append your local IP (e.g., http://192.168.1.50:5173).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Per-client in-memory rate limit (requests per window in seconds)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated list of trusted reverse proxy IPs allowed to supply X-Forwarded-For.
# Leave empty unless deployed behind a known reverse proxy whose peer IP you control.
TRUSTED_PROXIES=
