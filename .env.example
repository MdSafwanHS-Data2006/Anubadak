# Anubadak Root Environment Configuration Example
# Copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env

# Backend configuration (used in backend/.env)
MYMEMORY_API_URL=https://api.mymemory.translated.net/get
MYMEMORY_EMAIL=
REQUEST_TIMEOUT_SECONDS=10.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXIES=

# Frontend configuration (used in frontend/.env)
# Only place the public backend URL here — NEVER place secret keys in VITE_* variables
# (Use http://localhost:8000 for local dev or your LAN IP for mobile Wi-Fi testing)
VITE_API_BASE_URL=http://localhost:8000
